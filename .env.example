# PathPay — environment variables (Phase 01)
# Copy to .env and adjust per environment. NEVER commit .env.

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Postgres ---
DATABASE_URL=postgresql://pathpay:pathpay@localhost:5432/pathpay

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth (Phase 03) ---
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-me-with-32-bytes-of-random-hex
JWT_REFRESH_SECRET=replace-me-with-a-different-32-bytes-of-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d