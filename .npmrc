# pnpm settings for PathPay
# strict-dep-builds=false allows build scripts for native bindings
# (e.g. @parcel/watcher used by NestJS for hot reload) without prompts
strict-dep-builds=false
# Skip the deps-status check that fails when build scripts haven't run.
# This is safe — the app itself doesn't depend on those scripts at runtime.
verify-deps-before-run=false