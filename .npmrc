# pnpm settings for PathPay
# pnpm 11's strict build-script approval gate keeps re-injecting placeholders,
# which makes pnpm install noisy on every dependency change. We work around
# it by always running install with --ignore-scripts (configured here as a
# global default) and invoking specific build steps explicitly when needed
# (e.g. `pnpm exec prisma generate` after schema changes).
ignore-scripts=true